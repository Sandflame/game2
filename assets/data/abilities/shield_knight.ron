// Shield Knight: durable front-liner who holds enemies' attention.
[
    // ---- Core ----
    (
        id: "sk_shield_bash", name: "Shield Bash",
        description: "Slam your shield into the target. Starts your combo.",
        on_gcd: true, range: 3.5, target: Enemy,
        effects: [(effect: Damage(amount: 180))],
        vfx: "bash",
    ),
    (
        id: "sk_riposte", name: "Riposte",
        description: "A swift counter-thrust. Much stronger right after Shield Bash.",
        on_gcd: true, range: 3.5, target: Enemy,
        effects: [(effect: Damage(amount: 120))],
        combo: Some((after: "sk_shield_bash", amount: 300)),
        vfx: "slash",
    ),
    (
        id: "sk_taunt", name: "Taunt",
        description: "Challenge the target so it attacks you.",
        on_gcd: false, cooldown: 30.0, range: 20.0, target: Enemy,
        effects: [(effect: Taunt)],
        vfx: "taunt",
    ),
    (
        id: "sk_rampart", name: "Rampart",
        description: "Raise your guard, taking much less damage for a while.",
        on_gcd: false, cooldown: 90.0, target: Myself,
        effects: [(effect: ApplyStatus(status: "rampart"))],
        vfx: "buff_grey",
    ),
    (
        id: "sk_shield_sweep", name: "Shield Sweep",
        description: "Sweep your shield around you, striking every nearby enemy.",
        on_gcd: true, target: Myself,
        effects: [(to: EnemiesAround(centre: Me, radius: 5.0), effect: Damage(amount: 120))],
        vfx: "spin",
    ),

    // ---- Bulwark specialization ----
    (
        id: "sk_stalwart_guard", name: "Stalwart Guard",
        description: "Brace behind your shield, gaining a barrier.",
        on_gcd: false, cooldown: 60.0, target: Myself,
        effects: [(effect: Shield(amount: 2500, status: "stalwart_guard"))],
        vfx: "shield_light",
    ),
    (
        id: "sk_holdfast", name: "Holdfast",
        description: "Strike the target and recover some of your strength.",
        on_gcd: true, range: 3.5, target: Enemy,
        effects: [
            (effect: Damage(amount: 150)),
            (to: Myself, effect: Heal(amount: 350)),
        ],
        vfx: "bash",
    ),
    (
        id: "sk_iron_bastion", name: "Iron Bastion",
        description: "Become an unbreakable wall for a few seconds.",
        on_gcd: false, cooldown: 120.0, target: Myself,
        effects: [(effect: ApplyStatus(status: "iron_bastion"))],
        vfx: "buff_grey",
    ),

    // ---- Oath specialization: holy strikes and light healing ----
    (
        id: "sk_holy_strike", name: "Holy Strike",
        description: "A blessed strike that also mends your own wounds.",
        on_gcd: true, range: 3.5, target: Enemy,
        effects: [
            (effect: Damage(amount: 170)),
            (to: Myself, effect: Heal(amount: 200)),
        ],
        vfx: "spark_holy",
    ),
    (
        id: "sk_oathlight", name: "Oathlight",
        description: "Heal a friend (or yourself) with the light of your oath.",
        on_gcd: true, cast_time: 1.5, range: 30.0, target: Ally,
        effects: [(effect: Heal(amount: 450))],
        vfx: "heal",
    ),
    (
        id: "sk_consecrate", name: "Consecrate",
        description: "Bless the ground: enemies around you are burned and allies healed.",
        on_gcd: false, cooldown: 45.0, target: Myself,
        effects: [
            (to: EnemiesAround(centre: Me, radius: 6.0), effect: Damage(amount: 200)),
            (to: AlliesAround(centre: Me, radius: 15.0), effect: Heal(amount: 300)),
        ],
        vfx: "heal_area",
    ),

    // ---- Vanguard specialization: more damage ----
    (
        id: "sk_vanguard_cleave", name: "Vanguard Cleave",
        description: "A heavy blow with the edge of your shield.",
        on_gcd: true, range: 3.5, target: Enemy,
        effects: [(effect: Damage(amount: 280))],
        vfx: "slash_heavy",
    ),
    (
        id: "sk_shield_charge", name: "Shield Charge",
        description: "Charge at the target behind your shield.",
        on_gcd: false, cooldown: 20.0, range: 15.0, target: Enemy,
        effects: [(effect: Lunge), (effect: Damage(amount: 200))],
        vfx: "bash",
    ),
    (
        id: "sk_war_cry", name: "War Cry",
        description: "A rallying shout: you deal more damage for a while.",
        on_gcd: false, cooldown: 90.0, target: Myself,
        effects: [(effect: ApplyStatus(status: "war_cry"))],
        vfx: "buff_red",
    ),
]
