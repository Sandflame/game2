// Milestone 2 test abilities. Milestone 3 replaces these with real classes.
//   on_gcd:    uses the 1.5 s global cooldown
//   cast_time: seconds (0 = instant); moving cancels a cast
//   cooldown:  the ability's own cooldown in seconds
//   range:     metres to the edge of the target's ring
[
    (
        id: "strike",
        name: "Strike",
        description: "A quick swing of your lantern.",
        on_gcd: true,
        range: 3.5,
        target: Enemy,
        potency: 200,
        vfx: "hit_light",
    ),
    (
        id: "lantern_bolt",
        name: "Lantern Bolt",
        description: "Hurl a bolt of lantern fire. Moving cancels the cast.",
        on_gcd: true,
        cast_time: 2.0,
        range: 25.0,
        target: Enemy,
        potency: 380,
        vfx: "bolt_fire",
    ),
    (
        id: "flare_burst",
        name: "Flare Burst",
        description: "Your lantern flares brightly. Off the global cooldown.",
        on_gcd: false,
        cooldown: 15.0,
        range: 25.0,
        target: Enemy,
        potency: 300,
        vfx: "burst_fire",
    ),
]
