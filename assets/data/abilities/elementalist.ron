// Elementalist: ranged spells with cast times.
[
    // ---- Core ----
    (
        id: "el_firebolt", name: "Firebolt",
        description: "Hurl a bolt of fire.",
        on_gcd: true, cast_time: 1.5, range: 25.0, target: Enemy,
        effects: [(effect: Damage(amount: 280))],
        vfx: "bolt_fire",
    ),
    (
        id: "el_kindle", name: "Kindle",
        description: "An instant spark that sets the target burning.",
        on_gcd: true, range: 25.0, target: Enemy,
        effects: [
            (effect: Damage(amount: 120)),
            (effect: ApplyStatus(status: "burn")),
        ],
        vfx: "spark_fire",
    ),
    (
        id: "el_flame_wave", name: "Flame Wave",
        description: "A wave of fire that hits the target and enemies near it.",
        on_gcd: true, cast_time: 2.0, range: 25.0, target: Enemy,
        effects: [(to: EnemiesAround(centre: Target, radius: 5.0), effect: Damage(amount: 220))],
        vfx: "wave_fire",
    ),
    (
        id: "el_ember_shield", name: "Ember Shield",
        description: "Wrap yourself in a shield of embers.",
        on_gcd: false, cooldown: 90.0, target: Myself,
        effects: [(effect: Shield(amount: 1800, status: "ember_shield"))],
        vfx: "shield_fire",
    ),
    (
        id: "el_fire_snap", name: "Fire Snap",
        description: "Snap your fingers for an instant burst of flame.",
        on_gcd: false, cooldown: 30.0, range: 25.0, target: Enemy,
        effects: [(effect: Damage(amount: 260))],
        vfx: "spark_fire",
    ),

    // ---- Fire specialization ----
    (
        id: "el_inferno", name: "Inferno",
        description: "A long cast that engulfs the target in a towering blaze.",
        on_gcd: true, cast_time: 3.0, range: 25.0, target: Enemy,
        effects: [(effect: Damage(amount: 700))],
        vfx: "pillar_fire",
    ),
    (
        id: "el_combust", name: "Combust",
        description: "Flare the flames on your target and renew its burn.",
        on_gcd: false, cooldown: 45.0, range: 25.0, target: Enemy,
        effects: [
            (effect: Damage(amount: 200)),
            (effect: ApplyStatus(status: "burn")),
        ],
        vfx: "burst_fire",
    ),
    (
        id: "el_pyre_heart", name: "Pyre Heart",
        description: "Stoke your inner fire: your spells hit harder for a while.",
        on_gcd: false, cooldown: 120.0, target: Myself,
        effects: [(effect: ApplyStatus(status: "pyre_heart"))],
        vfx: "buff_red",
    ),

    // ---- Ice specialization: shields and slows ----
    (
        id: "el_frostbolt", name: "Frostbolt",
        description: "A bolt of ice that chills the target, slowing it.",
        on_gcd: true, cast_time: 1.5, range: 25.0, target: Enemy,
        effects: [
            (effect: Damage(amount: 240)),
            (effect: ApplyStatus(status: "chilled")),
        ],
        vfx: "bolt_ice",
    ),
    (
        id: "el_glacial_ward", name: "Glacial Ward",
        description: "Wrap a friend (or yourself) in a shell of ice.",
        on_gcd: false, cooldown: 45.0, range: 30.0, target: Ally,
        effects: [(effect: Shield(amount: 1500, status: "glacial_ward"))],
        vfx: "shield_ice",
    ),
    (
        id: "el_frost_nova", name: "Frost Nova",
        description: "A burst of frost around you that chills every enemy nearby.",
        on_gcd: true, target: Myself,
        effects: [
            (to: EnemiesAround(centre: Me, radius: 8.0), effect: Damage(amount: 180)),
            (to: EnemiesAround(centre: Me, radius: 8.0), effect: ApplyStatus(status: "chilled")),
        ],
        vfx: "burst_ice",
    ),

    // ---- Storm specialization: build static, then release it ----
    (
        id: "el_static_spark", name: "Static Spark",
        description: "An instant spark that builds static on the target (up to 4 times).",
        on_gcd: true, range: 25.0, target: Enemy,
        effects: [
            (effect: Damage(amount: 150)),
            (effect: ApplyStatus(status: "static_charge")),
        ],
        vfx: "bolt_storm",
    ),
    (
        id: "el_thunderclap", name: "Thunderclap",
        description: "Release the static in a thunderclap: stronger for each charge on the target.",
        on_gcd: true, range: 25.0, target: Enemy,
        effects: [(effect: StackedDamage(amount: 200, status: "static_charge", per_stack: 60, consume: true))],
        vfx: "burst_storm",
    ),
    (
        id: "el_lightning_lance", name: "Lightning Lance",
        description: "An instant lance of lightning for a big burst of damage.",
        on_gcd: false, cooldown: 40.0, range: 25.0, target: Enemy,
        effects: [(effect: Damage(amount: 650))],
        vfx: "bolt_storm",
    ),
]
