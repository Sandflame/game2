// Character models (looks only; the game rules never read this).
// The look was agreed in docs/art-direction.md.
(
    // The body shape that turns the chunky KayKit bodies into taller,
    // slimmer ones: the whole model's size, then how much bigger each
    // bone's part of the body is as (width, length, depth); 1 = unchanged.
    // A name without .l/.r covers both sides. Only the mesh is reshaped (the
    // skeleton's bones keep their size), so poses never skew it.
    proportions: (
        scale: 0.56,
        bones: {
            "head":     (0.5, 0.5, 0.5),
            "hips":     (0.88, 1.0, 0.88),
            "spine":    (0.88, 1.35, 0.88),
            "chest":    (0.94, 1.15, 0.94),
            "upperarm": (0.95, 1.7, 0.95),
            "lowerarm": (0.95, 1.7, 0.95),
            "upperleg": (0.95, 3.0, 0.95),
            "lowerleg": (0.95, 3.0, 0.95),
        },
    ),

    // Body files. Everything the pack puts in the hands is hidden (weapons
    // come from `weapons` below); `hide` lists extra parts to hide, `tint`
    // recolours the clothes (red, green, blue; 1 = unchanged).
    bodies: {
        "knight":    (file: "models/kaykit/Knight.glb"),
        "mage":      (file: "models/kaykit/Mage.glb"),
        "mage_bare": (file: "models/kaykit/Mage.glb", hide: ["Mage_Hat"]),
        "priest":    (file: "models/kaykit/Mage.glb", hide: ["Mage_Hat"], tint: (0.8, 0.95, 1.5)),
        "rogue":     (file: "models/kaykit/Rogue.glb"),
        "ranger":    (file: "models/kaykit/Rogue_Hooded.glb"),
        "barbarian": (file: "models/kaykit/Barbarian.glb", hide: ["Barbarian_Hat"]),
        "lamplighter": (file: "models/kaykit/Mage.glb", hide: ["Mage_Hat"], tint: (1.3, 0.95, 0.6)),
    },

    // Hand-held items. They hang from the hand bones; `offset` moves them
    // within the hand (metres, before the model's scale).
    weapons: {
        "sword":      (file: "models/kaykit/sword_1handed.gltf"),
        "greatsword": (file: "models/kaykit/sword_2handed.gltf"),
        "axe":        (file: "models/kaykit/axe_1handed.gltf"),
        "dagger":     (file: "models/kaykit/dagger.gltf"),
        "staff":      (file: "models/kaykit/staff.gltf"),
        "wand":       (file: "models/kaykit/wand.gltf"),
        "spellbook":  (file: "models/kaykit/spellbook_open.gltf", offset: (0.0, 0.15, 0.0), rotation: Some((0.0, -0.7071, -0.7071, 0.0))),
        "shield":     (file: "models/kaykit/shield_badge.gltf", offset: (0.0, 0.0, 0.16)),
    },

    // What each class wears (until gear has looks) and holds, by
    // specialization. `style` picks the idle pose and attack swings:
    // OneHanded, TwoHanded, DualWield or Caster.
    classes: {
        "blademaster": (body: "rogue", specs: {
            "greatsword":  (right: Some("greatsword"), style: TwoHanded),
            "scissors":    (right: Some("dagger"), left: Some("dagger"), style: DualWield),
            "one_handed":  (right: Some("sword"), style: OneHanded),
            "dual_blades": (right: Some("sword"), left: Some("sword"), style: DualWield),
        }),
        "elementalist": (body: "mage", specs: {
            "fire":  (right: Some("staff"), style: Caster),
            "ice":   (right: Some("staff"), style: Caster),
            "storm": (right: Some("staff"), style: Caster),
        }),
        "shield_knight": (body: "knight", specs: {
            "bulwark":  (right: Some("sword"), left: Some("shield"), style: OneHanded),
            "oath":     (right: Some("sword"), left: Some("shield"), style: OneHanded),
            "vanguard": (right: Some("axe"), left: Some("shield"), style: OneHanded),
        }),
        "priest": (body: "priest", specs: {
            "mender":    (right: Some("wand"), left: Some("spellbook"), style: Caster),
            "enchanter": (right: Some("staff"), style: Caster),
            "judge":     (right: Some("wand"), left: Some("spellbook"), style: Caster),
        }),
    },

    // Townsfolk, by their `visual` in zone data.
    people: {
        "townsfolk_lamplighter": (body: "lamplighter"),
        "townsfolk_keeper":      (body: "barbarian"),
        "townsfolk_guard":       (body: "knight", right: Some("sword"), left: Some("shield")),
        "townsfolk_ranger":      (body: "ranger"),
    },

    // Players' faces with hair (races.ron `faces`): a head taken from one of
    // the pack's bodies (the node holding its mesh). Skin and hair are
    // recoloured to the player's choice.
    heads: {
        "long_hair":  (file: "models/kaykit/Rogue.glb", mesh: "Rogue_Head"),
        "short_hair": (file: "models/kaykit/Mage.glb", mesh: "Mage_Head"),
        "cropped":    (file: "models/kaykit/Knight.glb", mesh: "Knight_Head"),
        "bald_beard": (file: "models/kaykit/Barbarian.glb", mesh: "Barbarian_Head"),
    },

    // What each race feature style (races.ron `features`) adds. Pieces:
    // long_ears, swept_ears, cat_ears, lynx_ears (skin / hair coloured),
    // swept_horns, crowned_horns, rising_horns, ram_horns, cheek_scales,
    // dragon_tail, demon_tail (feature coloured), cat_tail (hair coloured).
    features: {
        "long_ears":     ["long_ears"],
        "swept_ears":    ["swept_ears"],
        "swept_horns":   ["swept_horns", "cheek_scales", "dragon_tail"],
        "crowned_horns": ["crowned_horns", "cheek_scales", "dragon_tail"],
        "rising_horns":  ["rising_horns", "demon_tail"],
        "ram_horns":     ["ram_horns", "demon_tail"],
        "cat_ears":      ["cat_ears", "cat_tail"],
        "lynx_ears":     ["lynx_ears", "cat_tail"],
    },

    // Body parts players never show (any node whose name contains one of
    // these): their face and hair come from their look, and hats would hide
    // them.
    player_hides: ["_Head", "_Hat", "_Helmet"],

    // Gear rarity looks (built in `client/src/gear.rs`). The weapon's
    // rarity decides `weapon` pieces, the tint (multiplies the weapon's
    // colours) and its glow (in the trim colour); the Body piece's rarity
    // decides the `armour` pieces. `name_color` colours item names.
    // Armour: RoundPauldrons, Pauldrons, Spikes, LongSpikes, BeltGem,
    // Motes(count), Wings, Halo. Weapon: GripGem, GripRing, Sparks(count).
    tiers: {
        Common: (name_color: (0.92, 0.9, 0.85)),
        Uncommon: (
            name_color: (0.45, 0.9, 0.45),
            plate: (0.7, 0.74, 0.7), trim: (0.3, 0.75, 0.35), trim_glow: 0.4,
            weapon_glow: 0.12,
            armour: [RoundPauldrons, BeltGem],
            weapon: [GripGem],
        ),
        Rare: (
            name_color: (0.4, 0.65, 1.0),
            plate: (0.75, 0.82, 0.95), trim: (0.3, 0.6, 1.0), trim_glow: 1.5,
            accent: (0.95, 0.75, 0.3),
            weapon_tint: (0.95, 1.0, 1.1), weapon_glow: 0.3,
            armour: [Pauldrons, BeltGem],
            weapon: [GripGem, Sparks(3)],
        ),
        Epic: (
            name_color: (0.78, 0.45, 1.0),
            plate: (0.25, 0.18, 0.36), trim: (0.85, 0.3, 1.0), trim_glow: 3.0,
            accent: (0.75, 0.75, 0.85),
            weapon_tint: (0.55, 0.45, 0.8), weapon_glow: 0.6,
            armour: [Pauldrons, Spikes, BeltGem, Motes(6)],
            weapon: [GripGem, Sparks(5)],
        ),
        Legendary: (
            name_color: (1.0, 0.75, 0.3),
            plate: (0.97, 0.95, 0.9), trim: (0.35, 0.95, 1.0), trim_glow: 5.0,
            accent: (1.0, 0.8, 0.35), accent_glow: 0.4,
            weapon_tint: (1.15, 1.1, 0.95), weapon_glow: 0.8,
            armour: [Pauldrons, LongSpikes, BeltGem, Wings, Halo, Motes(10)],
            weapon: [GripGem, GripRing, Sparks(6)],
        ),
    },

    // Animation clips (names inside the KayKit files) for each action.
    animations: (
        idle: { OneHanded: "Idle", TwoHanded: "2H_Melee_Idle", DualWield: "Idle", Caster: "Idle" },
        attacks: {
            OneHanded: ["1H_Melee_Attack_Chop", "1H_Melee_Attack_Slice_Diagonal", "1H_Melee_Attack_Slice_Horizontal"],
            TwoHanded: ["2H_Melee_Attack_Chop", "2H_Melee_Attack_Slice", "2H_Melee_Attack_Spin"],
            DualWield: ["Dualwield_Melee_Attack_Chop", "Dualwield_Melee_Attack_Slice", "Dualwield_Melee_Attack_Stab"],
            Caster:    ["Spellcast_Shoot"],
        },
        run: "Running_A",
        jump: "Jump_Idle",
        cast: "Spellcasting",
        release: "Spellcast_Shoot",
        lantern: "Spellcast_Raise",
        ride: "Sit_Floor_Idle",
        defeated: "Death_A",
        // Faster than this (metres per second) counts as running.
        run_above: 0.5,
        // Seconds to blend from one animation into the next.
        blend: 0.15,
        // Attack swings play this much faster than the files' own speed.
        attack_speed: 1.4,
    ),
)
