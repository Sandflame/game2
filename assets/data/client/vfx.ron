// Visual effects for abilities (looks only; the game rules never read this).
// Each ability's `vfx` name is looked up here when it lands.
//   style: Projectile (flies from user to target, then bursts)
//          Burst      (a flash that swells at the target)
//          Slash      (a quick arc at the target)
//          Ring       (a ring that spreads over the ground from the user)
//          Rise       (a glow rising from the target: heals and buffs)
//   color: (red, green, blue), 0.0 - 1.0 (values above 1 glow brighter)
//   size:  roughly metres
{
    // Blademaster / general weapon hits
    "slash":        (style: Slash, color: (1.0, 0.95, 0.85), size: 1.2),
    "slash_heavy":  (style: Slash, color: (1.0, 0.75, 0.5), size: 1.8),
    "spin":         (style: Ring, color: (1.0, 0.9, 0.7), size: 5.0),
    "slam":         (style: Burst, color: (1.0, 0.6, 0.3), size: 3.0),
    "bash":         (style: Burst, color: (0.7, 0.85, 1.0), size: 1.0),
    "buff_red":     (style: Rise, color: (1.0, 0.35, 0.3), size: 1.0),
    "buff_grey":    (style: Rise, color: (0.8, 0.85, 0.95), size: 1.0),

    // Elementalist
    "bolt_fire":    (style: Projectile, color: (1.6, 0.7, 0.2), size: 0.35),
    "spark_fire":   (style: Burst, color: (1.6, 0.6, 0.2), size: 1.0),
    "wave_fire":    (style: Burst, color: (1.6, 0.5, 0.15), size: 4.5),
    "pillar_fire":  (style: Rise, color: (1.8, 0.6, 0.15), size: 2.0),
    "burst_fire":   (style: Burst, color: (1.8, 0.8, 0.2), size: 1.8),
    "shield_fire":  (style: Rise, color: (1.4, 0.7, 0.3), size: 1.2),

    // Shield Knight
    "taunt":        (style: Ring, color: (1.0, 0.3, 0.25), size: 2.0),
    "shield_light": (style: Rise, color: (0.8, 0.9, 1.4), size: 1.2),

    // Priest
    "bolt_holy":    (style: Projectile, color: (1.4, 1.3, 0.8), size: 0.3),
    "spark_holy":   (style: Burst, color: (1.4, 1.3, 0.8), size: 1.0),
    "heal":         (style: Rise, color: (0.5, 1.4, 0.6), size: 1.0),
    "heal_area":    (style: Ring, color: (0.5, 1.4, 0.6), size: 15.0),
    "heal_big":     (style: Rise, color: (0.8, 1.6, 0.8), size: 1.8),
    "buff_holy":    (style: Rise, color: (1.4, 1.3, 0.8), size: 1.0),

    // Enemies
    "burst_nature": (style: Burst, color: (0.6, 1.2, 0.4), size: 3.0),
    "bolt_nature":  (style: Projectile, color: (0.6, 1.2, 0.4), size: 0.25),
}
