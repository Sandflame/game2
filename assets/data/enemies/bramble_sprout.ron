// Small thorny sprouts: easy experience. They fling thorns at anyone who
// comes close, and grow back a while after being defeated.
(
    name: "Bramble Sprout",
    max_health: 3000,
    hit_radius: 0.8,
    visual: "thornling",
    // Back on its feet (full health) this long after it was last hit.
    reset_after: 20.0,
    actions: [(ability: "thorn_prick", every: 3.0)],
    xp: 90,
    move_speed: 3.0,
    aggro_radius: 7.0,
    leash_radius: 25.0,
    assist_radius: 7.0,
)
