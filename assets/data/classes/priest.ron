// Priest — sustain. Flame: pearl.
(
    name: "Priest",
    description: "A healer who keeps friends standing with holy light.",
    flame: "pearl",
    role: Sustain,
    max_health: 9000,
    // Power in percent: 100 = abilities do exactly their listed amounts,
    // 110 = 10% more damage and healing.
    power: 100,
    threat_multiplier: 1.0,
    core: ["pr_stone", "pr_mend", "pr_renew", "pr_sanctuary", "pr_smite"],
    // Warden (barriers) and Judge (damage that heals) arrive in Milestone 10.
    specializations: [
        (
            id: "mender",
            name: "Mender",
            description: "Big, reliable heals.",
            abilities: ["pr_benediction", "pr_grace", "pr_blessing"],
        ),
    ],
    default_spec: "mender",
    // Abilities other classes can borrow (secondary class), once this
    // class reaches the level shown.
    lendable: [
        (ability: "pr_mend", level: 1),
        (ability: "pr_renew", level: 5),
        (ability: "pr_grace", level: 10),
        (ability: "pr_sanctuary", level: 15),
    ],
)
