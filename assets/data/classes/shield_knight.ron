// Shield Knight — durable. Flame: azure.
(
    name: "Shield Knight",
    description: "A guardian who draws enemies' attention and shrugs off blows.",
    flame: "azure",
    role: Durable,
    max_health: 14000,
    // Power in percent: 100 = abilities do exactly their listed amounts,
    // 110 = 10% more damage and healing.
    power: 85,
    // Durable classes make enemies much angrier, so they attack them.
    threat_multiplier: 5.0,
    core: ["sk_shield_bash", "sk_riposte", "sk_taunt", "sk_rampart", "sk_shield_sweep"],
    // Oath (holy, light healing) and Vanguard (damage) arrive in Milestone 10.
    specializations: [
        (
            id: "bulwark",
            name: "Bulwark",
            description: "Barriers and mitigation to outlast anything.",
            abilities: ["sk_stalwart_guard", "sk_holdfast", "sk_iron_bastion"],
        ),
    ],
    default_spec: "bulwark",
    // Abilities other classes can borrow (secondary class), once this
    // class reaches the level shown.
    lendable: [
        (ability: "sk_rampart", level: 1),
        (ability: "sk_stalwart_guard", level: 5),
        (ability: "sk_taunt", level: 10),
        (ability: "sk_shield_sweep", level: 15),
    ],
)
