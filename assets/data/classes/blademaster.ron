// Blademaster — damage. Flame: crimson.
(
    name: "Blademaster",
    description: "A swordfighter who strikes in fast combos up close.",
    flame: "crimson",
    role: Damage,
    max_health: 10000,
    // Power in percent: 100 = abilities do exactly their listed amounts,
    // 110 = 10% more damage and healing.
    power: 110,
    // Threat per point of damage or healing.
    threat_multiplier: 1.0,
    // Hotbar slots 1-5.
    core: ["bm_slash", "bm_rending_cut", "bm_finishing_edge", "bm_whirlwind", "bm_battle_focus"],
    // Each specialization fills slots 6-8. (Scissors, one-handed sword and
    // dual blades arrive in Milestone 10.)
    specializations: [
        (
            id: "greatsword",
            name: "Greatsword",
            description: "Slow, crushing blows that also hit nearby enemies.",
            abilities: ["bm_earthsplitter", "bm_overhead_crush", "bm_iron_will"],
        ),
        (
            id: "scissors",
            name: "Scissors",
            description: "Twin blades that snip: build up notches, then Shear them all at once. Leaps in to close the gap.",
            abilities: ["bm_snip", "bm_shear", "bm_scissor_lunge"],
        ),
        (
            id: "one_handed",
            name: "One-handed Sword",
            description: "Balanced and steady, with a parry to turn blows aside.",
            abilities: ["bm_precise_thrust", "bm_parry", "bm_counterstrike"],
        ),
        (
            id: "dual_blades",
            name: "Dual Blades",
            description: "Two full-sized swords: fast attacks that hit again and again.",
            abilities: ["bm_twin_strike", "bm_flurry", "bm_blade_dance"],
        ),
    ],
    default_spec: "greatsword",
    // Abilities other classes can borrow (secondary class), once this
    // class reaches the level shown.
    lendable: [
        (ability: "bm_battle_focus", level: 1),
        (ability: "bm_whirlwind", level: 5),
        (ability: "bm_iron_will", level: 10),
        (ability: "bm_overhead_crush", level: 15),
        (ability: "bm_parry", level: 20),
    ],
)
