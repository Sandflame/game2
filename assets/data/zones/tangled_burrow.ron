    name: "The Tangled Burrow",
    half_size: 52.0,
    spawn_point: (0.0, 0.0, 42.0),
    spawn_yaw: 0.0,
    ground: "burrow",
    ambience: "burrow_motes",
    // Each group gets its own copy; defeated enemies stay down.
    instanced: true,
    // Nobody gets back up alone: be raised, or everyone returns to the
    // entrance when the whole group falls.
    revive_in_place: false,
    level_sync: Some(8),
    exit: Some((to: "whisperwood", arrive: (57.5, 0.0, -18.0), arrive_yaw: 1.5708)),
    listing: Some((
        kind: "Dungeon",
        description: "A short crawl through the roots under Whisperwood. Three foes wait below: the Burrow Matriarch, Mother Sporecap and the Rotheart.",
