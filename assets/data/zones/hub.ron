// Lanternhold: the magitech hub city. Each district leads to a different
// world; only Rootwell (north, the giant root) is open so far.
(
    name: "Lanternhold",
    half_size: 50.0,
    spawn_point: (0.0, 0.0, 12.0),
    ground: "plaza",
    border: "city_wall",
    ambience: "lantern_motes",
    obstacles: [
        // The great lantern fountain in the plaza.
        (shape: Cylinder(radius: 3.2, height: 1.0), position: (0.0, 0.0, 0.0), visual: "fountain"),
        // The giant root rising from Rootwell, north of the plaza.
        (shape: Cylinder(radius: 8.0, height: 40.0), position: (0.0, 0.0, -40.0), visual: "giant_root"),
        (shape: Box(half_x: 4.0, half_z: 3.0, height: 4.5), position: (-18.0, 0.0, -14.0), visual: "house"),
        (shape: Box(half_x: 4.0, half_z: 3.5, height: 4.5), position: (-18.0, 0.0, -4.0), visual: "house"),
        (shape: Box(half_x: 3.0, half_z: 3.0, height: 6.5), position: (-18.0, 0.0, 6.0), visual: "house"),
        (shape: Box(half_x: 3.0, half_z: 3.0, height: 6.5), position: (-18.0, 0.0, 16.0), visual: "house"),
        (shape: Box(half_x: 3.5, half_z: 3.0, height: 4.5), position: (-18.0, 0.0, 26.0), visual: "house"),
        (shape: Box(half_x: 3.0, half_z: 3.0, height: 4.5), position: (18.0, 0.0, -14.0), visual: "house"),
        (shape: Box(half_x: 4.0, half_z: 3.0, height: 6.5), position: (18.0, 0.0, -4.0), visual: "house"),
        (shape: Box(half_x: 3.0, half_z: 3.5, height: 4.5), position: (18.0, 0.0, 6.0), visual: "house"),
        (shape: Box(half_x: 3.5, half_z: 3.5, height: 4.5), position: (18.0, 0.0, 16.0), visual: "house"),
        (shape: Box(half_x: 3.0, half_z: 3.5, height: 5.5), position: (18.0, 0.0, 26.0), visual: "house"),
        (shape: Cylinder(radius: 1.6, height: 12.0), position: (-30.0, 0.0, -28.0), visual: "tower"),
        (shape: Cylinder(radius: 1.6, height: 12.0), position: (30.0, 0.0, -28.0), visual: "tower"),
        (shape: Cylinder(radius: 1.6, height: 12.0), position: (-34.0, 0.0, 8.0), visual: "tower"),
        (shape: Cylinder(radius: 1.6, height: 12.0), position: (34.0, 0.0, 8.0), visual: "tower"),
        (shape: Cylinder(radius: 1.6, height: 12.0), position: (-22.0, 0.0, 36.0), visual: "tower"),
        (shape: Cylinder(radius: 1.6, height: 12.0), position: (22.0, 0.0, 36.0), visual: "tower"),
    ],
    decorations: [
        (visual: "lamp_post", position: (-6.0, 0.0, 6.0)),
        (visual: "lamp_post", position: (6.0, 0.0, 6.0)),
        (visual: "lamp_post", position: (-6.0, 0.0, -6.0)),
        (visual: "lamp_post", position: (6.0, 0.0, -6.0)),
        (visual: "lamp_post", position: (-6.0, 0.0, -18.0)),
        (visual: "lamp_post", position: (6.0, 0.0, -18.0)),
        (visual: "lamp_post", position: (-6.0, 0.0, 18.0)),
        (visual: "lamp_post", position: (6.0, 0.0, 18.0)),
        (visual: "lamp_post", position: (-6.0, 0.0, 30.0)),
        (visual: "lamp_post", position: (6.0, 0.0, 30.0)),
        (visual: "lamp_post", position: (-26.0, 0.0, -2.0)),
        (visual: "lamp_post", position: (26.0, 0.0, -2.0)),
        (visual: "lamp_post", position: (-26.0, 0.0, 14.0)),
        (visual: "lamp_post", position: (26.0, 0.0, 14.0)),
        (visual: "root_arch", position: (-9.0, 0.0, -26.0), yaw: 0.4),
        (visual: "root_arch", position: (9.0, 0.0, -26.0), yaw: -0.4),
        (visual: "root_arch", position: (-12.0, 0.0, -31.0), yaw: 0.9),
        (visual: "root_arch", position: (12.0, 0.0, -31.0), yaw: -0.9),
        (visual: "bush", position: (-3.0, 0.0, -27.0), scale: 1.2),
        (visual: "bush", position: (3.0, 0.0, -27.0), scale: 1.2),
        (visual: "bush", position: (-10.0, 0.0, -22.0), scale: 1.2),
        (visual: "bush", position: (10.0, 0.0, -22.0), scale: 1.2),
        (visual: "bush", position: (-5.0, 0.0, -23.0), scale: 1.2),
        (visual: "bush", position: (5.0, 0.0, -23.0), scale: 1.2),
        (visual: "banner", position: (-13.0, 0.0, -14.0), yaw: 0.6),
    ],
    portals: [
        // The dungeon board: lists the dungeons and trials, and takes you there.
        (position: (10.5, 0.0, 1.0), radius: 2.0, board: true, visual: "dungeon_board",
         label: "Dungeon board"),
        // Rootwell: slide down the giant root to the forest.
        (position: (0.0, 0.0, -31.0), radius: 2.4, ride: Some("root_slide"),
         label: "Slide down the giant root (to Whisperwood)", visual: "root_entrance"),
        // Districts that are not open yet.
        (position: (46.0, 0.0, 0.0), radius: 3.0, visual: "district_gate", arrive_yaw: 1.5708,
         label: "Harbour District", closed: Some("The Harbour's ships are still being built. Come back later!")),
        (position: (-46.0, 0.0, 0.0), radius: 3.0, visual: "district_gate", arrive_yaw: -1.5708,
         label: "Railyard District", closed: Some("The trains aren't running yet. The Railyard is closed for now.")),
        (position: (32.0, 0.0, 44.0), radius: 3.0, visual: "district_gate", arrive_yaw: 2.5,
         label: "Skydock District", closed: Some("The skyships are still docked for repairs.")),
        (position: (-32.0, 0.0, 44.0), radius: 3.0, visual: "district_gate", arrive_yaw: -2.5,
         label: "Clockwork Quarter", closed: Some("The time machine is not ready. (It will be ready... eventually.)")),
        // The training grounds: practice dummies.
        (position: (0.0, 0.0, 44.0), radius: 2.0, to: "sandbox", arrive: (0.0, 0.0, 8.0),
         label: "To the Training Grounds"),
    ],
    npcs: [
        (name: "Lamplighter Ilsa", visual: "townsfolk_lamplighter", position: (4.0, 0.0, 9.0), yaw: 2.6,
         lines: [
            "Welcome to Lanternhold! Every road out of the city starts here.",
            "Your lantern holds your flame. Press L to change it - any class, any time out of combat.",
            "Rootwell is to the north. Walk into the giant root and slide all the way down to Whisperwood.",
            "The other districts are still being built. Their gates are closed for now.",
            "Looking for adventure? The dungeon board by the fountain lists every dungeon and trial.",
         ]),
        (name: "Root Keeper Fen", visual: "townsfolk_keeper", position: (-4.0, 0.0, -26.0), yaw: -0.6,
         lines: [
            "The root goes all the way down to the forest floor. Hold on tight!",
            "Whisperwood has thornwolves. Hit one and the whole pack comes running.",
            "To come back up, find the climbing vines by the old tree.",
         ]),
        (name: "Gatewarden Brom", visual: "townsfolk_guard", position: (40.0, 0.0, 4.0), yaw: 2.0,
         lines: [
            "The Harbour's closed, friend. Ships aren't finished.",
            "Rootwell is open, though. North of the fountain.",
         ]),
        (name: "Trainer Mara", visual: "townsfolk_guard", position: (4.0, 0.0, 40.0), yaw: 2.8,
         lines: [
            "The Training Grounds are through here: dummies to practise on.",
            "Try a secondary flame: borrow two abilities from another class (L).",
         ]),
    ],
)
