// Buffs and debuffs. `duration` in seconds.
//   tick: Some(Damage(amount: N)) or Some(Heal(amount: N)) every tick_interval (combat.ron)
//   modifiers: multipliers while active, e.g. damage_dealt: 1.2 = +20% damage,
//              damage_taken: 0.7 = 30% less damage taken.
//   Shields (used by Shield effects) only need a name and duration.
[
    // ---- Blademaster ----
    (id: "battle_focus", name: "Battle Focus", kind: Buff, duration: 15.0,
     description: "Dealing 20% more damage.",
     modifiers: (damage_dealt: 1.2)),
    (id: "iron_will", name: "Iron Will", kind: Buff, duration: 10.0,
     description: "Taking 20% less damage.",
     modifiers: (damage_taken: 0.8)),
    (id: "snipped", name: "Snipped", kind: Debuff, duration: 12.0, max_stacks: 5,
     description: "Notched by scissor blades. Shear cuts deeper for each notch."),
    (id: "parry", name: "Parry", kind: Buff, duration: 4.0,
     description: "Turning blows aside: taking 50% less damage.",
     modifiers: (damage_taken: 0.5)),

    // ---- Elementalist ----
    (id: "burn", name: "Burn", kind: Debuff, duration: 18.0,
     description: "Taking fire damage over time.",
     tick: Some(Damage(amount: 50)), vfx: "burning"),
    (id: "ember_shield", name: "Ember Shield", kind: Buff, duration: 15.0,
     description: "A shield of embers absorbs damage."),
    (id: "pyre_heart", name: "Pyre Heart", kind: Buff, duration: 20.0,
     description: "Dealing 25% more damage.",
     modifiers: (damage_dealt: 1.25)),
    (id: "chilled", name: "Chilled", kind: Debuff, duration: 8.0,
     description: "Moving 40% slower.",
     modifiers: (move_speed: 0.6)),
    (id: "glacial_ward", name: "Glacial Ward", kind: Buff, duration: 12.0,
     description: "A shell of ice absorbs damage."),
    (id: "static_charge", name: "Static Charge", kind: Debuff, duration: 15.0, max_stacks: 4,
     description: "Crackling with static. Thunderclap hits harder for each charge."),

    // ---- Shield Knight ----
    (id: "rampart", name: "Rampart", kind: Buff, duration: 15.0,
     description: "Taking 30% less damage.",
     modifiers: (damage_taken: 0.7)),
    (id: "stalwart_guard", name: "Stalwart Guard", kind: Buff, duration: 10.0,
     description: "A barrier absorbs damage."),
    (id: "iron_bastion", name: "Iron Bastion", kind: Buff, duration: 8.0,
     description: "Taking 60% less damage.",
     modifiers: (damage_taken: 0.4)),
    (id: "war_cry", name: "War Cry", kind: Buff, duration: 15.0,
     description: "Dealing 25% more damage.",
     modifiers: (damage_dealt: 1.25)),

    // ---- Priest ----
    (id: "renew", name: "Renew", kind: Buff, duration: 15.0,
     description: "Recovering health over time.",
     tick: Some(Heal(amount: 140)), vfx: "renew"),
    (id: "holy_burn", name: "Holy Burn", kind: Debuff, duration: 18.0,
     description: "Seared by holy light.",
     tick: Some(Damage(amount: 45))),
    (id: "blessed", name: "Blessed", kind: Buff, duration: 15.0,
     description: "Receiving 25% more healing.",
     modifiers: (healing_received: 1.25)),
    (id: "aegis", name: "Aegis", kind: Buff, duration: 15.0,
     description: "An enchanted barrier absorbs damage."),
    (id: "ward_circle", name: "Ward", kind: Buff, duration: 12.0,
     description: "A ward absorbs damage."),
    (id: "enchanted_armour", name: "Enchanted Armour", kind: Buff, duration: 12.0,
     description: "Taking 20% less damage.",
     modifiers: (damage_taken: 0.8)),
]
